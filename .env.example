# Django Core & Domain Configuration
LAZARUS_SITE_URL=https://lazarusprotocol.online
DJANGO_SECRET_KEY=lazarus-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,lazarus-backend,host.docker.internal,lazarusprotocol.online,www.lazarusprotocol.online
DJANGO_CORS_ALLOWED_ORIGINS=https://lazarusprotocol.online,https://www.lazarusprotocol.online,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_DB=lazarus_db
POSTGRES_USER=lazarus
POSTGRES_PASSWORD=lazarus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Optional full connection URI override:
# DATABASE_URL=postgresql://lazarus:lazarus@localhost:5432/lazarus_db

# Redis Cache & Celery Broker Configuration
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
LAZARUS_CACHE_DEFAULT_TTL=30

